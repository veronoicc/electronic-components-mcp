{
  "name": "@veronoicc/electronic-components-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for electronic components search, store comparisons, and multi-store cart management",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veronoicc/electronic-components-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/veronoicc/electronic-components-mcp/issues"
  },
  "homepage": "https://github.com/veronoicc/electronic-components-mcp#readme",
  "bin": {
    "electronic-components-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "electronic-components",
    "electronics",
    "arduino",
    "esp32",
    "raspberry-pi",
    "berrybase",
    "roboter-bausatz",
    "eckstein",
    "watterott",
    "aliexpress"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "impit": "^0.14.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
